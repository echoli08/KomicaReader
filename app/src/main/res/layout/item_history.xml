<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/historyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/kr_text" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/historyUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/kr_secondary" android:textSize="12sp" />
</LinearLayout>
