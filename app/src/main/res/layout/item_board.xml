<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/boardName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/kr_text" />

    <!-- 最愛切換：48dp 觸控目標 + borderless ripple -->
    <TextView
        android:id="@+id/favoriteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_favorite"
        android:gravity="center"
        android:text="@string/label_favorite_empty"
        android:textColor="@color/kr_warning"
        android:textSize="24sp" />
</LinearLayout>
