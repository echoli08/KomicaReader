<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <com.komica.reader.widget.ZoomImageView
        android:id="@+id/splitImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/label_image_preview"
        android:scaleType="matrix" />

    <ProgressBar
        android:id="@+id/pageProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/pageError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/split_decode_failed"
        android:textColor="@android:color/white"
        android:visibility="gone" />
</FrameLayout>
